# --- Kind cluster basics ---
KIND_CLUSTER_NAME=dify-kind
# Set to an existing kind config file if you want to override the auto-generated one.
KIND_CONFIG_FILE=
# Host ports exposed on the control-plane node for ingress traffic.
KIND_HTTP_PORT=80
KIND_HTTPS_PORT=443

# --- Ingress controller ---
INGRESS_CONTROLLER_MANIFEST=https://raw.githubusercontent.com/kubernetes/ingress-nginx/main/deploy/static/provider/kind/deploy.yaml

# --- Local images to load into kind (comma-separated)
LOCAL_DOCKER_IMAGES=your-image:tag
# --- Kubernetes namespaces ---
K8S_NAMESPACE=dify
# Override only if you want to point kubectl/helm at a non-default context.
K8S_CONTEXT=

# --- Docker Hub credentials ---
DOCKER_USERNAME=yourname
DOCKER_PAT=your-pat

# --- Persistent volume claim ---
PVC_BASE_NAME=dify-backend-pvc
PV_BASE_NAME=dify-backend-pv
# Supply the application/version identifier (e.g. 3.4.1) to suffix the PVC/PV names.
# Leave empty to auto-use the Helm version detected during deployment.
PVC_VERSION_TAG=
PVC_STORAGE_CLASS=standard
PVC_ACCESS_MODE=ReadWriteOnce
PVC_SIZE=10Gi
PVC_ANNOTATIONS=helm.sh/resource-policy=keep

# --- Postgres persistent volume claim ---
# Leave POSTGRES_PVC_VERSION_TAG empty to reuse PVC_VERSION_TAG/helm chart version.
# Leave POSTGRES_PVC_STORAGE_CLASS empty to reuse PVC_STORAGE_CLASS.
POSTGRES_PVC_BASE_NAME=dify-postgres-pvc
POSTGRES_PVC_VERSION_TAG=
POSTGRES_PVC_STORAGE_CLASS=
POSTGRES_PVC_ACCESS_MODE=ReadWriteOnce
POSTGRES_PVC_SIZE=10Gi
POSTGRES_PVC_ANNOTATIONS=helm.sh/resource-policy=keep

# --- Helm release ---
HELM_RELEASE_NAME=dify
HELM_NAMESPACE=dify
HELM_CHART=dify/dify
HELM_VALUES_FILE=values.yaml
HELM_VERSION=latest
HELM_CHART_VERSION=3.5.0
# Optional helm repo info; leave empty to skip `helm repo add`.
HELM_REPO_NAME=dify
HELM_REPO_URL=https://langgenius.github.io/dify-helm
# Extra helm args, e.g. `--debug --set key=val`.
HELM_ADDITIONAL_ARGS=
